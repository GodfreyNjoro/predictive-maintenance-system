# ===========================================
# Predictive Maintenance System - Configuration
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# DATABASE (Required)
# -------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/predictive_maintenance"

# -------------------------------------------
# AUTHENTICATION (Required)
# -------------------------------------------
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# Your application URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# FILE STORAGE (Choose one mode)
# -------------------------------------------

# OPTION 1: Local Storage (default, no cloud needed)
STORAGE_MODE="local"
# LOCAL_UPLOADS_DIR="./uploads"  # Optional, defaults to ./uploads

# OPTION 2: AWS S3 Storage (for production)
# STORAGE_MODE="s3"
# AWS_REGION="us-west-2"
# AWS_BUCKET_NAME="your-bucket-name"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_FOLDER_PREFIX=""  # Optional prefix for all uploads

# -------------------------------------------
# OPTIONAL SETTINGS
# -------------------------------------------

# Node environment
# NODE_ENV="development"

# Logging level
# LOG_LEVEL="info"

# -------------------------------------------
# LLM PROVIDER (Intelligence / analysis feature)
# -------------------------------------------
# Chat-completions endpoint used by /api/intelligence/analyze.
# Defaults to the OpenAI-compatible endpoint if unset.
# LLM_API_URL="https://api.openai.com/v1/chat/completions"
# API key for the above provider.
LLM_API_KEY="your-llm-api-key"

# -------------------------------------------
# DATABASE INGESTION (Phase 1 — DataSource secrets)
# -------------------------------------------
# AES-256-GCM key (32 bytes, base64-encoded) used to encrypt remote
# DataSource passwords / tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored DataSource credential.
PMS_DSN_KEY="generate-32-bytes-base64-and-replace"

# Shared secret the external scheduler/cron task presents in the
# `x-pms-scheduler-key` header to invoke /api/scheduler/run without a
# user session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_TRIGGER_KEY="generate-32-bytes-hex-and-replace"

# -------------------------------------------
# EDGE COLLECTOR (Phase 4)
# -------------------------------------------
# Shared secret for the edge collector agent to authenticate against
# POST /api/ingest/batch. Generate with: openssl rand -base64 32
# EDGE_COLLECTOR_KEY=""
